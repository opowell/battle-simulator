{
  "name": "battle-simulator",
  "type": "module",
  "version": "1.1.0",
  "engines": {
    "node": ">=18"
  },
  "imports": {
    "#core/*": "./src/*",
    "#obscuro/*": "./vendor/obscuro/src/*",
    "#browser/*": "./apps/browser/*"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node api-server.js",
    "bench:generic": "node demo/generic-ai-bench.mjs",
    "build-release": "node scripts/build-release.mjs",
    "test": "node scripts/test.mjs",
    "kill:port:3333": "lsof -i tcp:3333 | awk 'NR!=1 {print $2}' | xargs kill -9"
  },
  "dependencies": {
    "bignumber.js": "^11.1.5"
  }
}
